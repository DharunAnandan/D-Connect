{
  "name": "d-connect",
  "productName": "D-Connect",
  "version": "1.0.2",
  "description": "Your phone, on your PC. Linux-first phone link with eye care.",
  "main": "out/main/index.js",
  "author": "Dharun",
  "homepage": "https://github.com/DharunAnandan/D-Connect",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "icons": "env -u ELECTRON_RUN_AS_NODE electron scripts/make-icons.cjs",
    "fake-phone": "node scripts/fake-phone.mjs",
    "icons:android": "env -u ELECTRON_RUN_AS_NODE electron scripts/make-android-icon.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bonjour-service": "^1.4.4",
    "dbus-next": "^0.10.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.78.0",
    "node-forge": "^1.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "xml2js": "^0.6.2"
  }
}
